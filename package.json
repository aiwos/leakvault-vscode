{
  "name": "leakvault",
  "displayName": "LeakVault — AI Credential Guard",
  "description": "Intercepts passwords, API keys, tokens and connection strings before they reach AI chat servers. Works with GitHub Copilot Chat, Claude Code, and Cursor.",
  "version": "0.1.17",
  "publisher": "SylwesterUlatowski",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiwos/leakvault-vscode"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/license-MIT-green.svg",
      "href": "https://github.com/aiwos/leakvault-vscode/blob/main/LICENSE",
      "description": "MIT License"
    },
    {
      "url": "https://img.shields.io/badge/security-credential%20protection-blue.svg",
      "href": "https://github.com/aiwos/leakvault-vscode",
      "description": "Protects credentials from reaching AI servers"
    }
  ],
  "keywords": [
    "security",
    "credentials",
    "secrets",
    "copilot",
    "ai",
    "leak",
    "vault"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "leakvault.guard",
        "name": "leakvault",
        "fullName": "LeakVault Guard",
        "description": "Scan your message for credentials before sending to the AI",
        "isSticky": false,
        "commands": [
          {
            "name": "scan",
            "description": "Scan and redact credentials from a message, then answer"
          },
          {
            "name": "vault",
            "description": "List stored credential handles in the vault"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "leakvault.scanClipboard",
        "title": "LeakVault: Scan & Redact Clipboard"
      },
      {
        "command": "leakvault.scanSelection",
        "title": "LeakVault: Scan & Redact Selection"
      },
      {
        "command": "leakvault.openVault",
        "title": "LeakVault: Open Vault"
      },
      {
        "command": "leakvault.toggleProtection",
        "title": "LeakVault: Toggle Protection"
      },
      {
        "command": "leakvault.installHooks",
        "title": "LeakVault: Install Copilot Chat Hooks"
      }
    ],
    "configuration": {
      "title": "LeakVault",
      "properties": {
        "leakvault.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable LeakVault credential interception"
        },
        "leakvault.notifyOnDetection": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when credentials are detected and redacted"
        },
        "leakvault.autoInstallHooks": {
          "type": "boolean",
          "default": true,
          "description": "Automatically configure Copilot Chat hooks on extension activation"
        },
        "leakvault.vaultDir": {
          "type": "string",
          "default": "",
          "description": "Custom path for the encrypted vault directory (default: ~/.leakvault)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.9.3"
  }
}
